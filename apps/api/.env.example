# VITAL API environment
NODE_ENV=development
PORT=3000

# Supabase Postgres connection string — use the TRANSACTION POOLER (port 6543).
# Format: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# URL-encode any special characters in the password. The API client uses prepare:false for this pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project.
#
# ⚠️ This file is tracked in git. NEVER put real values here — earlier revisions
# of this file contained a live service-role key and JWT secret, which are still
# in git history and must be rotated (see AUTH_ARCHITECTURE.md §10). A
# service-role key grants full database access and bypasses RLS. Backend only:
# it must never reach the web or mobile bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key-from-the-supabase-dashboard>
SUPABASE_JWT_SECRET=<jwt-secret-from-the-supabase-dashboard>
# Storage bucket for admin-uploaded lab PDFs (create it in Supabase Storage)
SUPABASE_STORAGE_BUCKET=lab-results

# Paymob (Egyptian payment gateway)
PAYMOB_API_KEY=dummy
PAYMOB_INTEGRATION_ID=1
PAYMOB_IFRAME_ID=1
PAYMOB_HMAC_SECRET=dummy
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMENT_RETURN_URL=https://vital.app/payment/return